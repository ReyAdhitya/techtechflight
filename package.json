{
  "name": "techtechflight",
  "private": true,
  "type": "module",
  "workspaces": [
    "contract",
    "fleet-core",
    "fleet-adapters",
    "ground-station",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=ground-station & npm run dev --workspace=web",
    "dev:ground-station": "npm run dev --workspace=ground-station",
    "dev:web": "npm run dev --workspace=web",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:devices": "node scripts/audit-devices.mjs",
    "fetch:yolo": "node scripts/fetch-yolo-model.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p fleet-core/tsconfig.json && tsc --noEmit -p fleet-adapters/tsconfig.json && tsc --noEmit -p web/tsconfig.json"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@vercel/node": "^5.9.2",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.61.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.6.1"
  }
}
